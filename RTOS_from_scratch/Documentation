    while(1) {
        rtos_semaphore_wait(adc_ready_sem, UINT32_MAX);
        uint16_t data = read_adc();
        process_data(data);
    }
}

void ADC_IRQHandler(void) {
    rtos_semaphore_signal(adc_ready_sem);
}
```

